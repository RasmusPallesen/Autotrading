# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ── Alpaca ─────────────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true          # Set to false for live trading (be careful!)

# ── Coinbase Advanced Trade ────────────────────────────────────────────────────
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
COINBASE_SANDBOX=true      # Set to false for live crypto trading

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── ntfy push notifications ────────────────────────────────────────────────────
NTFY_TOPIC=your-trading-alerts-topic
NTFY_CMD_TOPIC=your-trading-commands-topic
NTFY_BASE_URL=https://ntfy.sh           # Change if self-hosting ntfy

# ── Dashboard (used by controller "dashboard" command) ─────────────────────────
DASHBOARD_URL=http://YOUR_SERVER_IP:8501  # Public URL of the Streamlit dashboard
